#include "myserve.h"


int c_fd;


//int listen(int sockfd, int backlog);
//int bind(int sockfd, const struct sockaddr *addr,socklen_t addrlen);

//int socket(int domain, int type, int protocol);

int socket_create(int domain, int type, int protocol)
{
  int server_fd;
  server_fd = socket(domain, type, protocol);
  if(server_fd == -1)//创建一个套接字失败
  {
    perror("socket");//打印错误信息   
    return 0;
  }
  
  struct sockaddr_in s_addr;
  s_addr.sin_family = AF_INET;
  s_addr.sin_port = htons(8889);

  inet_aton("192.168.163.149",&s_addr.sin_addr);//转换格式
  //bind
  int ret = bind(server_fd, (struct sockaddr *)&s_addr, sizeof(struct sockaddr_in));
  if(ret != 0)
  {
    perror("bind");//打印错误信息
  }


  //listen
  ret = listen(server_fd,10);
  if(ret != 0)
  {
    printf("listen error\n");
  }

  return server_fd;

}

clientmes socket_accept(int server_fd)
{
  clientmes temp;
  struct sockaddr_in client_addr;
  int len = sizeof(struct sockaddr_in);

  c_fd=accept(server_fd,(struct sockaddr *)&client_addr,&len);
  //if(c_fd == -1)
  //{
  //  perror("accept error\n");
  //}

  temp.client_fd = c_fd;
  temp.s_addr = client_addr;

  return temp;
}




void sockettest()
{
  int s_fd;
  struct sockaddr_in s_addr;
  struct sockaddr_in c_addr;

  //socket
  s_fd = socket(AF_INET, SOCK_STREAM, 0);
  if(s_fd == -1)//创建一个套接字失败
  {
    perror("socket");//打印错误信息
    //exit(-1);
    return ;
  }
 /* 配置 */
  s_addr.sin_family = AF_INET;
  s_addr.sin_port = htons(8888);
  inet_aton("192.168.163.147",&s_addr.sin_addr);//转换格式

  //bind
  bind(s_fd, (struct sockaddr *)&s_addr, sizeof(struct sockaddr_in));


  //listen
  listen(s_fd,10);


  //accept
  int len = sizeof(struct sockaddr_in);
  int c_fd=accept(s_fd,(struct sockaddr *)&c_addr,&len);

  printf("connect succes\n");
}

  
  


